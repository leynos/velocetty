{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "minLength": 1,
    "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
  },
  "additionalProperties": {
    "anyOf": [
      {
        "type": "string",
        "pattern": "\\S"
      },
      {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    ]
  },
  "properties": {
    "$schema": {
      "pattern": "\\S",
      "type": "string"
    }
  }
}
