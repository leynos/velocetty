/*
 * Proof obligations for the per-field editing state machine.
 *
 * `stepField` is the pure transition function behind one settings field: the
 * owning store sends it an event and runs the single effect it returns. This
 * module proves that the function preserves `wellFormed` and that each
 * transition keeps the guarantees its annotated contracts state: request ids
 * advance monotonically, a stale outcome is a no-op, a current outcome settles
 * the saving phase, a snapshot refresh cannot overwrite a dirty draft or an
 * in-flight request, and every effect agrees with the event that produced it.
 *
 * This file is the generated model plus hand-authored additions. The generated
 * body comes from `shared/src/settings/field-state.ts`, the shipped TypeScript
 * implementation, through `lsc gen --backend=dafny`; the committed artefact is
 * `shared/src/settings/field-state.dfy.gen`. The additions here are the
 * non-vacuity witnesses (`idleWitness` through `failedWitness`, with their
 * `witness_*` lemmas), which show `wellFormed` is satisfiable in every phase
 * the machine claims to produce, and the `reachable_saving` and
 * `reachable_idle_after_applied` reachability lemmas, which show the
 * documented transitions reach the saving and idle phases from the state a
 * store starts in. The diff from the generated artefact must stay
 * additions-only, so no generated function, datatype, or contract may be
 * edited here.
 *
 * `test/unit/settings-field-state.property.test.ts` exercises the same
 * transitions: it walks generated event sequences through the shipped
 * `stepField` and checks the invariants that span several transitions. Those
 * tests are evidence that the verified model still describes the
 * implementation; they are not a refinement proof.
 */

datatype Option<T> = None | Some(value: T)

datatype FieldPhase = idle | invalid | saving | rejected | failed

datatype FieldOutcomeResult = applied | denied | errored

datatype FieldState<V, E> = FieldState(phase: FieldPhase, committed: Option<V>, draft: string, isDirty: bool, errors: seq<E>, pendingRequestId: int, nextRequestId: int)

datatype FieldEvent<V, E> = edit(draft: string) | revert(draft: string) | submit(submission: FieldSubmission<V, E>, fallbackError: E) | reset | outcome(requestId: int, result: FieldOutcomeResult, errors: seq<E>, fallbackError: E) | refresh(committed: Option<V>, draft: string)

datatype FieldSubmission<V, E> = coerced(value: V) | uncoerced(errors: seq<E>)

datatype FieldEffect<V> = none(requestId: int) | write(requestId: int, value: V) | reset(requestId: int)

datatype StepResult<V, E> = StepResult(state: FieldState<V, E>, effect: FieldEffect<V>)

function wellFormed<V, E>(state: FieldState<V, E>): bool
{
  var isSaving := state.phase.saving?;
  var hasPending := (state.pendingRequestId >= 0);
  var isErrorPhase := ((state.phase.invalid? || state.phase.rejected?) || state.phase.failed?);
  ((((isSaving == hasPending) && (state.pendingRequestId < state.nextRequestId)) && (state.nextRequestId >= 1)) && ((|state.errors| > 0) == isErrorPhase))
}

function failurePhaseOf(result: FieldOutcomeResult): FieldPhase
{
  if result.denied? then
    var rejectedPhase := FieldPhase.rejected;
    rejectedPhase
  else
    var failedPhase := FieldPhase.failed;
    failedPhase
}

function settledPhase(phase: FieldPhase): FieldPhase
{
  if phase.saving? then
    var savingPhase := FieldPhase.saving;
    savingPhase
  else
    var idlePhase := FieldPhase.idle;
    idlePhase
}

function isRefreshEvent<V, E>(event: FieldEvent<V, E>): bool
{
  event.refresh?
}

function refreshCommitted<V, E>(event: FieldEvent<V, E>, fallback: Option<V>): Option<V>
{
  match event {
    case refresh(i_event_committed, i_event_draft) =>
      i_event_committed
    case _ =>
      fallback
  }
}

function isSubmitEvent<V, E>(event: FieldEvent<V, E>): bool
{
  event.submit?
}

function isCurrentOutcome<V, E>(event: FieldEvent<V, E>, pendingRequestId: int): bool
{
  match event {
    case outcome(i_event_requestId, i_event_result, i_event_errors, i_event_fallbackError) =>
      (i_event_requestId == pendingRequestId)
    case _ =>
      false
  }
}

function isStaleOutcome<V, E>(event: FieldEvent<V, E>, pendingRequestId: int): bool
{
  match event {
    case outcome(i_event_requestId, i_event_result, i_event_errors, i_event_fallbackError) =>
      (i_event_requestId != pendingRequestId)
    case _ =>
      false
  }
}

function hasWriteEffect<V>(effect: FieldEffect<V>): bool
{
  effect.write?
}

function hasResetEffect<V>(effect: FieldEffect<V>): bool
{
  effect.reset?
}

function effectRequestId<V>(effect: FieldEffect<V>): int
{
  effect.requestId
}

function effectCarriesSubmitted<V(==), E(==)>(effect: FieldEffect<V>, event: FieldEvent<V, E>): bool
{
  match effect {
    case write(i_effect_requestId, i_effect_value) =>
      match event {
        case submit(i_event_submission, i_event_fallbackError) =>
          if (!i_event_submission.coerced?) then
            false
          else
            (i_effect_value == i_event_submission.value)
        case _ =>
          false
      }
    case _ =>
      false
  }
}

function stepField<V(==), E(==)>(state: FieldState<V, E>, event: FieldEvent<V, E>): StepResult<V, E>
  requires wellFormed(state)
{
  var noEffect := none(-1);
  match event {
    case edit(i_event_draft) =>
      var phase := settledPhase(state.phase);
      var next := state.(phase := phase, draft := i_event_draft, isDirty := true, errors := []);
      StepResult(next, noEffect)
    case revert(i_event_draft) =>
      var phase := settledPhase(state.phase);
      var next := state.(phase := phase, draft := i_event_draft, isDirty := false, errors := []);
      StepResult(next, noEffect)
    case submit(i_event_submission, i_event_fallbackError) =>
      var requestId := state.nextRequestId;
      if i_event_submission.coerced? then
        var phase_2 := FieldPhase.saving;
        var next_2 := state.(phase := phase_2, errors := [], isDirty := false, pendingRequestId := requestId, nextRequestId := (requestId + 1));
        var effect := write(requestId, i_event_submission.value);
        StepResult(next_2, effect)
      else
        var phase := FieldPhase.invalid;
        var errors := (if (|i_event_submission.errors| > 0) then i_event_submission.errors else [i_event_fallbackError]);
        var next := state.(phase := phase, errors := errors, isDirty := true, pendingRequestId := -1);
        StepResult(next, noEffect)
    case reset =>
      var requestId := state.nextRequestId;
      var phase := FieldPhase.saving;
      var next := state.(phase := phase, errors := [], isDirty := false, pendingRequestId := requestId, nextRequestId := (requestId + 1));
      var effect := FieldEffect.reset(requestId);
      StepResult(next, effect)
    case outcome(i_event_requestId, i_event_result, i_event_errors, i_event_fallbackError) =>
      if (i_event_requestId != state.pendingRequestId) then
        StepResult(state, noEffect)
      else
        if i_event_result.applied? then
          var phase_3 := FieldPhase.idle;
          var next_3 := state.(phase := phase_3, errors := [], pendingRequestId := -1);
          StepResult(next_3, noEffect)
        else
          var phase := failurePhaseOf(i_event_result);
          var errors := (if (|i_event_errors| > 0) then i_event_errors else [i_event_fallbackError]);
          var next := state.(phase := phase, errors := errors, isDirty := true, pendingRequestId := -1);
          StepResult(next, noEffect)
    case refresh(i_event_committed, i_event_draft) =>
      if (state.isDirty || (state.pendingRequestId >= 0)) then
        var next_4 := state.(committed := i_event_committed);
        StepResult(next_4, noEffect)
      else
        var phase := FieldPhase.idle;
        var next := state.(committed := i_event_committed, draft := i_event_draft, phase := phase, errors := []);
        StepResult(next, noEffect)
  }
}

lemma stepField_ensures<V, E>(state: FieldState<V, E>, event: FieldEvent<V, E>)
  requires wellFormed(state)
  ensures wellFormed(stepField(state, event).state)
  ensures (stepField(state, event).state.nextRequestId >= state.nextRequestId)
  ensures (isStaleOutcome(event, state.pendingRequestId) ==> ((stepField(state, event).state == state) && stepField(state, event).effect.none?))
  ensures (state.phase.saving? ==> isCurrentOutcome(event, state.pendingRequestId) ==> (!stepField(state, event).state.phase.saving?))
  ensures (isRefreshEvent(event) ==> (state.isDirty || (state.pendingRequestId >= 0)) ==> (stepField(state, event).state.draft == state.draft))
  ensures (stepField(state, event).effect.write? ==> isSubmitEvent(event))
  ensures (stepField(state, event).effect.reset? ==> event.reset?)
  ensures (effectCarriesSubmitted(stepField(state, event).effect, event) || !(hasWriteEffect(stepField(state, event).effect)))
  ensures ((!stepField(state, event).effect.none?) ==> (effectRequestId(stepField(state, event).effect) == stepField(state, event).state.pendingRequestId))
  ensures (stepField(state, event).state.committed == refreshCommitted(event, state.committed))
  ensures (event.reset? ==> stepField(state, event).effect.reset?)
{
}

// ── Non-vacuity witnesses ───────────────────────────────────
// One well-formed state per phase, so the invariant is satisfiable in every
// phase the machine claims to produce. Values are `int` because the machine
// never inspects them.

function idleWitness(): FieldState<int, int> {
  FieldState(idle, None, "", false, [], -1, 1)
}

function invalidWitness(): FieldState<int, int> {
  FieldState(invalid, None, "x", true, [0], -1, 2)
}

function savingWitness(): FieldState<int, int> {
  FieldState(saving, None, "x", false, [], 0, 1)
}

function rejectedWitness(): FieldState<int, int> {
  FieldState(rejected, None, "x", true, [0], -1, 2)
}

function failedWitness(): FieldState<int, int> {
  FieldState(failed, None, "x", true, [0], -1, 2)
}

// ── Reachability witnesses ──────────────────────────────────
// The functions above show well-formedness is satisfiable in every phase.
// These lemmas show the documented transitions actually reach the saving and
// idle phases from the state a store starts in.

lemma reachable_saving()
{
  var initial: FieldState<int, int> := FieldState(idle, None, "", false, [], -1, 1);
  var submit: FieldEvent<int, int> := submit(coerced(1), 0);
  var next := stepField(initial, submit).state;
  assert wellFormed(next);
  assert next.phase.saving?;
}

lemma reachable_idle_after_applied()
{
  var initial: FieldState<int, int> := FieldState(idle, None, "", false, [], -1, 1);
  var submit: FieldEvent<int, int> := submit(coerced(1), 0);
  var saving := stepField(initial, submit).state;
  var outcome: FieldEvent<int, int> := outcome(1, applied, [], 0);
  var next := stepField(saving, outcome).state;
  assert wellFormed(next);
  assert next.phase.idle?;
}

lemma witness_idle()
  ensures wellFormed(idleWitness())
{
}

lemma witness_invalid()
  ensures wellFormed(invalidWitness())
{
}

lemma witness_saving()
  ensures wellFormed(savingWitness())
{
}

lemma witness_rejected()
  ensures wellFormed(rejectedWitness())
{
}

lemma witness_failed()
