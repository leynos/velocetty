function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

function {:axiom} StringSplit(s: string, d: string): seq<string>
  requires |d| > 0
  ensures |StringSplit(s, d)| >= 1
  ensures |StringSplit(s, d)| <= |s| + 1
  ensures forall k :: 0 <= k < |StringSplit(s, d)| ==> |StringSplit(s, d)[k]| <= |s|

datatype SearchFields = SearchFields(haystacks: seq<string>, modifiedFlags: seq<bool>, categoryIndices: seq<int>)

function tokensOf(query: string): seq<string>
{
  Std.Collections.Seq.Filter((part: string) => ((|part| > 0) && (part != "@modified")), StringSplit(query, " "))
}

function isModifiedQuery(query: string): bool
{
  (exists part :: part in StringSplit(query, " ") && (part == "@modified"))
}

function haystackMatchesTokens(haystack: string, tokens: seq<string>): bool
{
  Std.Collections.Seq.All(tokens, (token: string) => (StringIndexOf(haystack, token) >= 0))
}

function fieldMatchesQuery(query: string, haystack: string, isModified: bool, categoryMatches: bool): bool
{
  if (isModifiedQuery(query) && !(isModified)) then
    false
  else
    if !(categoryMatches) then
      false
    else
      haystackMatchesTokens(haystack, tokensOf(query))
}

method searchFieldIndices(query: string, fields: SearchFields, selectedCategory: int) returns (res: seq<int>)
  requires (|query| >= 0)
  requires (|fields.haystacks| == |fields.modifiedFlags|)
  requires (|fields.haystacks| == |fields.categoryIndices|)
  ensures forall k: nat :: ((k < |res|) ==> ((0 <= res[k]) && (res[k] < |fields.haystacks|)))
  ensures forall k: nat :: ((k < |res|) ==> fieldMatchesQuery(query, fields.haystacks[res[k]], fields.modifiedFlags[res[k]], ((selectedCategory < 0) || (fields.categoryIndices[res[k]] == selectedCategory))))
  ensures forall j: nat :: ((j < |fields.haystacks|) ==> fieldMatchesQuery(query, fields.haystacks[j], fields.modifiedFlags[j], ((selectedCategory < 0) || (fields.categoryIndices[j] == selectedCategory))) ==> (j in res))
  ensures forall k: nat :: ((0 < k) ==> (k < |res|) ==> (res[(k - 1)] < res[k]))
{
  var result: seq<int> := [];
  var index := 0;
  while (index < |fields.haystacks|)
    invariant (index >= 0)
    invariant (index <= |fields.haystacks|)
    invariant forall k: nat :: ((k < |result|) ==> ((0 <= result[k]) && (result[k] < index)))
    invariant forall k: nat :: ((k < |result|) ==> (result[k] < |fields.haystacks|) ==> (result[k] < |fields.modifiedFlags|) ==> (result[k] < |fields.categoryIndices|) ==> fieldMatchesQuery(query, fields.haystacks[result[k]], fields.modifiedFlags[result[k]], ((selectedCategory < 0) || (fields.categoryIndices[result[k]] == selectedCategory))))
    invariant forall j: nat :: ((j < index) ==> (j < |fields.haystacks|) ==> (j < |fields.modifiedFlags|) ==> (j < |fields.categoryIndices|) ==> fieldMatchesQuery(query, fields.haystacks[j], fields.modifiedFlags[j], ((selectedCategory < 0) || (fields.categoryIndices[j] == selectedCategory))) ==> (j in result))
    invariant forall k: nat :: ((0 < k) ==> (k < |result|) ==> (result[(k - 1)] < result[k]))
  {
    var haystack := fields.haystacks[index];
    var isModified := fields.modifiedFlags[index];
    var categoryIndex := fields.categoryIndices[index];
    var categoryMatches := ((selectedCategory < 0) || (categoryIndex == selectedCategory));
    var i_t0 := fieldMatchesQuery(query, haystack, isModified, categoryMatches);
    if i_t0 {
      result := (result + [index]);
    }
    index := (index + 1);
  }
  return result;
}
