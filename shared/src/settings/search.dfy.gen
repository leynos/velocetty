function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

function {:axiom} StringSplit(s: string, d: string): seq<string>
  requires |d| > 0
  ensures |StringSplit(s, d)| >= 1
  ensures |StringSplit(s, d)| <= |s| + 1
  ensures forall k :: 0 <= k < |StringSplit(s, d)| ==> |StringSplit(s, d)[k]| <= |s|

function tokensOf(query: string): seq<string>
{
  Std.Collections.Seq.Filter((part: string) => ((|part| > 0) && (part != "@modified")), StringSplit(query, " "))
}

function isModifiedQuery(query: string): bool
{
  (exists part :: part in StringSplit(query, " ") && (part == "@modified"))
}

function haystackMatchesTokens(haystack: string, tokens: seq<string>): bool
{
  Std.Collections.Seq.All(tokens, (token: string) => (StringIndexOf(haystack, token) >= 0))
}

function fieldMatchesQuery(query: string, haystack: string, isModified: bool, categoryIndex: int, selectedCategory: int): bool
{
  (((!(isModifiedQuery(query)) || isModified) && ((selectedCategory < 0) || (categoryIndex == selectedCategory))) && haystackMatchesTokens(haystack, tokensOf(query)))
}

method searchFieldIndices(query: string, haystacks: seq<string>, modifiedFlags: seq<bool>, categoryIndices: seq<int>, selectedCategory: int) returns (res: seq<int>)
  requires (|query| >= 0)
  requires (|haystacks| == |modifiedFlags|)
  requires (|haystacks| == |categoryIndices|)
  ensures forall k: nat :: ((k < |res|) ==> ((0 <= res[k]) && (res[k] < |haystacks|)))
  ensures forall k: nat :: ((k < |res|) ==> fieldMatchesQuery(query, haystacks[res[k]], modifiedFlags[res[k]], categoryIndices[res[k]], selectedCategory))
  ensures forall j: nat :: ((j < |haystacks|) ==> fieldMatchesQuery(query, haystacks[j], modifiedFlags[j], categoryIndices[j], selectedCategory) ==> (j in res))
  ensures forall k: nat :: ((0 < k) ==> (k < |res|) ==> (res[(k - 1)] < res[k]))
{
  var i_t0 := tokensOf(query);
  var tokens := i_t0;
  var i_t1 := isModifiedQuery(query);
  var modifiedOnly := i_t1;
  var result: seq<int> := [];
  var index := 0;
  while (index < |haystacks|)
    invariant (index >= 0)
    invariant (index <= |haystacks|)
    invariant forall k: nat :: ((k < |result|) ==> ((0 <= result[k]) && (result[k] < index)))
    invariant forall k: nat :: ((k < |result|) ==> (result[k] < |haystacks|) ==> (result[k] < |modifiedFlags|) ==> (result[k] < |categoryIndices|) ==> fieldMatchesQuery(query, haystacks[result[k]], modifiedFlags[result[k]], categoryIndices[result[k]], selectedCategory))
    invariant forall j: nat :: ((j < index) ==> (j < |haystacks|) ==> (j < |modifiedFlags|) ==> (j < |categoryIndices|) ==> fieldMatchesQuery(query, haystacks[j], modifiedFlags[j], categoryIndices[j], selectedCategory) ==> (j in result))
    invariant forall k: nat :: ((0 < k) ==> (k < |result|) ==> (result[(k - 1)] < result[k]))
  {
    var haystack := haystacks[index];
    var isModified := modifiedFlags[index];
    var categoryIndex := categoryIndices[index];
    var i_branch0 := ((!(modifiedOnly) || isModified) && ((selectedCategory < 0) || (categoryIndex == selectedCategory)));
    if i_branch0 {
      var i_t2 := haystackMatchesTokens(haystack, tokens);
      i_branch0 := i_t2;
    }
    if i_branch0 {
      result := (result + [index]);
    }
    index := (index + 1);
  }
  return result;
}
