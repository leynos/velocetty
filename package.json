{
  "name": "hyper",
  "version": "4.0.0-canary.5",
  "packageManager": "bun@1.3.7",
  "repository": "zeit/hyper",
  "scripts": {
    "fmt": "node node_modules/@biomejs/biome/bin/biome format --write .",
    "preinstall": "node bin/ensure-bun.cjs",
    "start": "echo 'please run `bun run dev` in one tab and then `bun run app` in another one'",
    "app": "node node_modules/cross-env/src/bin/cross-env.js ELECTRONMON_LOGLEVEL=error node node_modules/electronmon/bin/cli.js target",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -n \"Webpack,TypeScript\" -c \"cyan.bold,blue.bold\" \"bunx webpack-cli -w\" \"node node_modules/typescript/bin/tsc --build -v --pretty --watch --preserveWatchOutput\" -k",
    "build": "node node_modules/cross-env/src/bin/cross-env.js NODE_ENV=production bunx webpack-cli && node node_modules/typescript/bin/tsc -b -v && node node_modules/cross-env/src/bin/cross-env.js BABEL_ENV=production babel target/renderer/bundle.js --out-file target/renderer/bundle.js --no-comments --minified",
    "build:hyper-app": "bunx webpack-cli --config-name hyper-app",
    "lint": "node node_modules/@biomejs/biome/bin/biome check .",
    "test": "bun run lint && bun run test:unit",
    "test:unit": "node node_modules/ava/entrypoints/cli.mjs",
    "test:unit:watch": "bun run test:unit -- --watch",
    "test:e2e": "ava --config ava-e2e.config.js",
    "postinstall": "bun run v8-snapshot && bun run build:hyper-app && node bin/run-electron-builder.cjs install-app-deps && bun run rebuild-node-pty && node bin/copy-node-modules.js && node node_modules/husky/bin.mjs install && bun run generate-schema",
    "rebuild-node-pty": "node bin/rebuild-node-pty.cjs",
    "dist": "bun run build && node bin/run-electron-builder.cjs",
    "clean": "node ./bin/rimraf-standalone.js node_modules && node ./bin/rimraf-standalone.js ./app/node_modules && node ./bin/rimraf-standalone.js ./app/renderer",
    "v8-snapshot": "node bin/run-v8-snapshot.js",
    "v8-snapshot:arch": "bun run mk-snapshot && bun run cp-snapshot",
    "mk-snapshot": "node node_modules/cross-env/src/bin/cross-env.js ELECTRON_CUSTOM_VERSION=$npm_package_devDependencies_electron node bin/download-mksnapshot.js && node bin/mk-snapshot.js",
    "cp-snapshot": "node bin/cp-snapshot.js",
    "generate-schema": "bunx typescript-json-schema ./typings/config.d.ts rawConfig -o ./app/config/schema.json --required --ignoreErrors"
  },
  "license": "MIT",
  "author": {
    "name": "ZEIT, Inc.",
    "email": "team@zeit.co"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@react-icons/all-files": "^4.1.0",
    "@redux-devtools/extension": "^3.3.0",
    "args": "^5.0.3",
    "chalk": "^5.3.0",
    "clsx": "^2.1.0",
    "color": "^4.2.3",
    "columnify": "^1.6.0",
    "css-loader": "^7.1.1",
    "got": "^12.4.1",
    "json-loader": "^0.5.7",
    "lodash": "^4.17.21",
    "mousetrap": "chabou/mousetrap#useCapture",
    "ms": "^2.1.3",
    "open": "^8.4.2",
    "ora": "^8.0.1",
    "php-escape-shell": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "react-use": "^17.5.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "registry-url": "^6.0.1",
    "reselect": "^4.1.8",
    "seamless-immutable": "^7.1.4",
    "semver": "^7.6.0",
    "shebang-loader": "^0.0.1",
    "styled-jsx": "^5.1.2",
    "stylis": "^3.5.4",
    "typescript-json-schema": "^0.63.0",
    "uuid": "^9.0.1",
    "webpack-cli": "^5.1.4",
    "xterm": "^5.3.0",
    "xterm-addon-canvas": "^0.5.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-image": "^0.5.0",
    "xterm-addon-ligatures": "^0.7.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-unicode11": "^0.6.0",
    "xterm-addon-web-links": "^0.9.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@ava/babel": "^2.0.0",
    "@ava/typescript": "^4.1.0",
    "@babel/cli": "^7.24.1",
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-numeric-separator": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@biomejs/biome": "^2.3.13",
    "@electron/rebuild": "^3.6.0",
    "@types/args": "^5.0.3",
    "@types/async-retry": "^1.4.3",
    "@types/color": "^3.0.6",
    "@types/columnify": "^1.5.4",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.0",
    "@types/mousetrap": "^1.6.15",
    "@types/ms": "^0.7.34",
    "@types/node": "^16.18.113",
    "@types/plist": "^3.0.5",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/seamless-immutable": "^7.1.19",
    "@types/styled-jsx": "^2.2.9",
    "@types/uuid": "^9.0.8",
    "ajv": "^8.12.0",
    "ava": "^6.1.2",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^22.3.25",
    "electron-builder": "^24.13.3",
    "electron-link": "^0.6.0",
    "electron-mksnapshot": "^29.3.0",
    "electronmon": "^2.0.2",
    "happy-dom": "^20.3.9",
    "husky": "^9.0.11",
    "inquirer": "^9.2.18",
    "node-addon-api": "^8.0.0",
    "null-loader": "^4.0.1",
    "parse-url": "^8.1.0",
    "playwright": "^1.43.1",
    "plist": "^3.1.0",
    "prettier": "^3.2.5",
    "proxyquire": "^2.1.3",
    "style-loader": "^4.0.0",
    "terser": "^5.30.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0"
  },
  "overrides": {
    "node-gyp": "^10.0.0",
    "@electron/rebuild>node-gyp": "^10.0.0"
  },
  "electronmon": {
    "patterns": [
      "!app/**",
      "!lib/**",
      "!dist/**"
    ]
  }
}
