{
  "name": "hyper",
  "version": "4.0.0-canary.5",
  "packageManager": "bun@1.3.8",
  "repository": "zeit/hyper",
  "scripts": {
    "fmt": "bun node_modules/@biomejs/biome/bin/biome format --write .",
    "preinstall": "bun bin/ensure-bun.cjs && bun bin/ensure-node-gyp-build.cjs",
    "start": "echo 'please run `bun run dev` in one tab and then `bun run app` in another one'",
    "app": "bunx cross-env ELECTRONMON_LOGLEVEL=error bun node_modules/electronmon/bin/cli.js dist/app",
    "dev": "bun node_modules/concurrently/dist/bin/concurrently.js -n \"esbuild,TypeScript\" -c \"cyan.bold,blue.bold\" \"bun ./build/esbuild/build.ts --watch --mode=development\" \"bunx tsgo --build -v --pretty --watch --preserveWatchOutput\" -k",
    "build:shared": "bun bin/ensure-dist-dir.js && bunx tsgo --project shared/tsconfig.json",
    "build:frontend": "bunx tsgo --project frontend/tsconfig.json --noEmit",
    "build:backend": "bunx tsgo --project backend/tsconfig.json --noEmit",
    "build:packages": "bun run build:shared && bun run build:frontend && bun run build:backend",
    "build": "bun run build:packages && bunx cross-env NODE_ENV=production bun ./build/esbuild/build.ts --mode=production && bunx tsgo --project app/tsconfig.json",
    "build:hyper-app": "bun ./build/esbuild/build.ts --mode=production --target=hyper-app",
    "lint": "bun node_modules/@biomejs/biome/bin/biome check . && bun run check:boundaries",
    "check:types": "bunx tsgo --project tsconfig.typecheck.json",
    "audit": "bun scripts/run-audit.mjs",
    "test": "bun run lint && bun run test:unit",
    "test:unit:run": "bun test --max-concurrency=1 test/unit",
    "test:unit": "bun run test:unit:run",
    "test:unit:shuffled": "bun test --max-concurrency=1 --randomize --seed=12345 test/unit",
    "test:unit:watch": "bun test --watch test/unit",
    "test:unit:shuffled:watch": "bun test --watch --randomize --seed=12345 --max-concurrency=1 test/unit",
    "test:coverage:prepare": "bun ./bin/rimraf-standalone.js coverage",
    "test:coverage:run": "bun test --coverage test/unit",
    "test:coverage": "bun run test:coverage:prepare && bun run test:coverage:run",
    "benchmark:pty-frame-timing": "bun scripts/run-pty-frame-timing-benchmark.mjs",
    "test:e2e:prepare": "bun ./bin/rimraf-standalone.js dist/tmp/root/test && bun ./bin/ensure-e2e-dev-target.js",
    "test:e2e:run": "bunx cross-env RUN_E2E=1 bun test test/e2e/electron.e2e.test.ts",
    "test:e2e:fast": "bun run test:e2e:prepare && bun run test:e2e:run",
    "test:e2e:deep:prepare": "node ./node_modules/playwright/cli.js install chromium",
    "test:e2e:deep:run": "node ./node_modules/playwright/cli.js test -c playwright.e2e.config.ts",
    "test:e2e:deep": "bun run test:e2e:prepare && bun run test:e2e:deep:prepare && bun run test:e2e:deep:run",
    "test:e2e": "bun run test:e2e:fast",
    "postinstall": "bun run v8-snapshot && bun run build:hyper-app && bun bin/run-electron-builder.cjs install-app-deps && bun run rebuild-node-pty && bun bin/copy-node-modules.js && bun node_modules/husky/bin.mjs install && bun run generate-schema",
    "rebuild-node-pty": "bun bin/rebuild-node-pty.cjs",
    "dist": "bun run build && bun bin/run-electron-builder.cjs",
    "clean": "bun ./bin/rimraf-standalone.js node_modules && bun ./bin/rimraf-standalone.js ./app/node_modules && bun ./bin/rimraf-standalone.js ./app/renderer",
    "v8-snapshot": "bun bin/run-v8-snapshot.js",
    "v8-snapshot:arch": "bun run mk-snapshot && bun run cp-snapshot",
    "mk-snapshot": "bunx cross-env ELECTRON_CUSTOM_VERSION=$npm_package_devDependencies_electron bun bin/download-mksnapshot.js && bun bin/mk-snapshot.js",
    "cp-snapshot": "bun bin/cp-snapshot.js",
    "check:boundaries": "bun ./scripts/check-package-boundaries.mjs",
    "generate-schema": "bunx typescript-json-schema ./typings/config.d.ts rawConfig -o ./shared/schemas/schema.json --required --ignoreErrors && bun ./bin/sync-shared-schema.mjs && bun node_modules/@biomejs/biome/bin/biome format --write ./shared/schemas/schema.json ./app/config/schema.json"
  },
  "license": "MIT",
  "author": {
    "name": "ZEIT, Inc.",
    "email": "team@zeit.co"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@react-icons/all-files": "^4.1.0",
    "@redux-devtools/extension": "^3.3.0",
    "args": "^5.0.3",
    "chalk": "^5.3.0",
    "clsx": "^2.1.0",
    "color": "^4.2.3",
    "columnify": "^1.6.0",
    "got": "^12.4.1",
    "json5": "^2.2.3",
    "lodash": "^4.17.23",
    "mousetrap": "^1.6.5",
    "ms": "^2.1.3",
    "open": "^8.4.2",
    "ora": "^8.2.0",
    "php-escape-shell": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-use": "^17.6.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "registry-url": "^6.0.1",
    "reselect": "^4.1.8",
    "seamless-immutable": "^7.1.4",
    "semver": "^7.6.0",
    "styled-jsx": "^5.1.2",
    "stylis": "^3.5.4",
    "typescript-json-schema": "^0.67.1",
    "uuid": "^9.0.1",
    "xterm": "^5.3.0",
    "xterm-addon-canvas": "^0.5.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-image": "^0.5.0",
    "xterm-addon-ligatures": "^0.7.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-unicode11": "^0.6.0",
    "xterm-addon-web-links": "^0.9.0",
    "xterm-addon-webgl": "^0.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^2.3.13",
    "@electron/rebuild": "^3.6.0",
    "@types/args": "^5.0.3",
    "@types/async-retry": "^1.4.3",
    "@types/color": "^3.0.6",
    "@types/columnify": "^1.5.4",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.0",
    "@types/mousetrap": "^1.6.15",
    "@types/ms": "^0.7.34",
    "@types/node": "^24.10.12",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/seamless-immutable": "^7.1.19",
    "@types/uuid": "^9.0.8",
    "@typescript/native-preview": "^7.0.0-dev.20260128.1",
    "ajv": "6.14.0",
    "concurrently": "^8.2.2",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-builder": "^24.13.3",
    "electron-link": "^0.6.0",
    "electron-mksnapshot": "^40.2.1",
    "electronmon": "^2.0.4",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.3.9",
    "husky": "^9.0.11",
    "inquirer": "^13.3.0",
    "node-addon-api": "^8.0.0",
    "node-gyp": "^10.0.0",
    "node-gyp-build": "^4.7.1",
    "parse-url": "^8.1.0",
    "playwright": "^1.58.2",
    "plist": "^3.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@babel/runtime": "^7.28.6",
    "node-gyp": "^10.0.0",
    "@electron/rebuild>node-gyp": "^10.0.0",
    "cross-spawn": "^7.0.6",
    "tar": "^7.5.9",
    "ajv": "6.14.0",
    "lodash": "^4.17.23",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "ejs": "^3.1.10",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.2",
    "diff": "^5.2.0",
    "tmp": "^0.2.5"
  },
  "electronmon": {
    "patterns": [
      "!app/**",
      "!lib/**",
      "!dist/**"
    ]
  },
  "patchedDependencies": {
    "leveldown@5.6.0": "patches/leveldown@5.6.0.patch",
    "node-gyp-build@4.7.1": "patches/node-gyp-build@4.7.1.patch"
  }
}
