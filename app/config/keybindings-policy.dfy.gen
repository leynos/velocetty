const initialKeybindingsState: KeybindingsState := KeybindingsState(None)

method replayKeybindingObservations(history: seq<KeybindingsObservation>) returns (res: KeybindingsState)
  ensures (res.lastAccepted == specLatestAccepted(history))
{
  var state := initialKeybindingsState;
  var i := 0;
  while (i < |history|)
    invariant (0 <= i)
    invariant (i <= |history|)
    invariant (state.lastAccepted == specLatestAccepted(history[0..i]))
  {
    var observation := history[i];
    if false {
      break;
    }
    state := observeKeybindings(state, observation).state;
    i := (i + 1);
  }
  return state;
}
