datatype KeybindingsObservation = valid(keymaps: UserKeymaps) | missing | invalid | unreadable

datatype KeybindingsState = KeybindingsState(lastAccepted: Option<UserKeymaps>)

datatype ObservationResult = ObservationResult(state: KeybindingsState, status: string, usedLastKnownGood: bool)

datatype BootstrapFileState = present | missing | unreadable

datatype LegacyKeymapsSource = parsed_keymaps(keymaps: UserKeymaps) | parsed_empty | parsed_invalid | freshly_created | fell_back

datatype BootstrapDecision = write_nothing | defer | seed(keymaps: UserKeymaps)

datatype BootstrapInput = BootstrapInput(file: BootstrapFileState, legacy: LegacyKeymapsSource)

function observeKeybindings(state: KeybindingsState, observation: KeybindingsObservation): ObservationResult
{
  match observation {
    case valid(i_observation_keymaps) =>
      ObservationResult(KeybindingsState(Some(i_observation_keymaps)), "applied", false)
    case missing =>
      ObservationResult(KeybindingsState(Some(emptyUserKeymaps())), "applied", false)
    case _ =>
      ObservationResult(state, "kept", (match state.lastAccepted { case Some(i_) => true case None => false }))
  }
}

