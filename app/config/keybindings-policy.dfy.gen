  }
}

function bootstrapObservation(decision: BootstrapDecision, write: string): Option<KeybindingsObservation>
{
  match decision {
    case defer =>
      None
    case write_nothing =>
      None
    case seed(i_decision_keymaps) =>
      if (write == "not-attempted") then
        None
      else
        Some(valid(i_decision_keymaps))
  }
}

