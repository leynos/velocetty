function decideBootstrap(input: BootstrapInput): BootstrapDecision
{
  var legacy := input.legacy;
  if (!input.file.missing?) then
    BootstrapDecision.write_nothing
  else
    match legacy {
      case parsed_keymaps(i_legacy_keymaps) =>
        seed(i_legacy_keymaps)
      case parsed_empty =>
        seed(emptyUserKeymaps())
      case freshly_created =>
        seed(emptyUserKeymaps())
      case _ =>
        BootstrapDecision.defer
    }
}

