function specLatestAccepted(history: seq<KeybindingsObservation>): Option<UserKeymaps>
  decreases |history|
{
  if (|history| == 0) then
    None
  else
    var lastIndex := (|history| - 1);
    var last := history[lastIndex];
    if false then
      None
    else
      match last {
        case valid(i_last_keymaps) =>
          Some(i_last_keymaps)
        case missing =>
          Some(emptyUserKeymaps())
        case _ =>
          specLatestAccepted(history[0..lastIndex])
      }
}

