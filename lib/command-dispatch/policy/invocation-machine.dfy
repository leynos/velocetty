// Generated by lsc from invocation-machine.ts

datatype MachineOutcome = ok | rejected | failedHandler | failedResult | cancelledBefore | cancelledDuring

datatype ReportedOutcome = ok | rejected | failedHandler | failedResult | cancelledBefore | cancelledDuring | pending

datatype MachineState = admitting(gate: int) | awaitingGate | executing | settled(outcome: MachineOutcome, failedGate: int)

datatype MachineEvent = gatePassed | gateFailed | aborted | gateRan | gatePending | hostEmitted | handlerFulfilled(resultValid: bool) | handlerRejected(isAbortReason: bool)

datatype MachineAction = evaluateGate(gate: int) | openGate | runHandler | settle | idle

datatype MachineStep = MachineStep(state: MachineState, action: MachineAction)

function initialState(isAborted: bool): MachineStep
{
  if isAborted then
    MachineStep(settled(MachineOutcome.cancelledBefore, -1), MachineAction.settle)
  else
    MachineStep(admitting(0), evaluateGate(0))
}

lemma initialState_ensures(isAborted: bool)
  ensures (initialState(isAborted).state.settled? <==> isAborted)
  ensures (isAborted ==> (initialState(isAborted).state.settled? && initialState(isAborted).state.outcome.cancelledBefore?))
  ensures (!(isAborted) ==> (initialState(isAborted).state.admitting? && (initialState(isAborted).state.gate == 0)))
  ensures (isAborted ==> initialState(isAborted).action.settle?)
  ensures (!(isAborted) ==> (initialState(isAborted).action.evaluateGate? && (initialState(isAborted).action.gate == 0)))
{
}

function step(state: MachineState, event: MachineEvent): MachineStep
  requires (state.admitting? ==> ((state.gate >= 0) && (state.gate <= 3)))
{
  match state {
    case settled(i_state_outcome, i_state_failedGate) =>
      MachineStep(state, MachineAction.idle)
    case _ =>
      match event {
        case aborted =>
          match state {
            case executing =>
              MachineStep(settled(MachineOutcome.cancelledDuring, -1), MachineAction.settle)
            case _ =>
              MachineStep(settled(MachineOutcome.cancelledBefore, -1), MachineAction.settle)
          }
        case _ =>
          match state {
            case admitting(i_state_gate) =>
              match event {
                case gateFailed =>
                  MachineStep(settled(MachineOutcome.rejected, i_state_gate), MachineAction.settle)
                case gatePassed =>
                  if (i_state_gate == 3) then
                    MachineStep(MachineState.awaitingGate, MachineAction.openGate)
                  else
                    MachineStep(admitting((i_state_gate + 1)), evaluateGate((i_state_gate + 1)))
                case _ =>
                  MachineStep(state, MachineAction.idle)
              }
            case awaitingGate =>
              match event {
                case gateRan =>
                  MachineStep(MachineState.executing, MachineAction.runHandler)
                case _ =>
                  MachineStep(state, MachineAction.idle)
              }
            case _ =>
              match event {
                case hostEmitted =>
                  MachineStep(settled(MachineOutcome.ok, -1), MachineAction.settle)
                case handlerFulfilled(i_event_resultValid) =>
                  if i_event_resultValid then
                    MachineStep(settled(MachineOutcome.ok, -1), MachineAction.settle)
                  else
                    MachineStep(settled(MachineOutcome.failedResult, -1), MachineAction.settle)
                case handlerRejected(i_event_isAbortReason) =>
                  if i_event_isAbortReason then
                    MachineStep(settled(MachineOutcome.cancelledDuring, -1), MachineAction.settle)
                  else
                    MachineStep(settled(MachineOutcome.failedHandler, -1), MachineAction.settle)
                case _ =>
                  MachineStep(state, MachineAction.idle)
              }
          }
      }
  }
}

lemma step_ensures(state: MachineState, event: MachineEvent)
  requires (state.admitting? ==> ((state.gate >= 0) && (state.gate <= 3)))
  ensures (state.settled? ==> ((step(state, event).state == state) && step(state, event).action.idle?))
  ensures ((!state.settled?) ==> event.aborted? ==> step(state, event).state.settled?)
  ensures (step(state, event).action.runHandler? <==> (state.awaitingGate? && event.gateRan?))
  ensures ((!state.settled?) ==> step(state, event).state.settled? ==> step(state, event).state.outcome.rejected? ==> (step(state, event).state.failedGate >= 0))
  ensures (state.admitting? ==> event.gateFailed? ==> step(state, event).state.outcome.rejected?)
  ensures (state.admitting? ==> event.gateFailed? ==> (step(state, event).state.failedGate == state.gate))
  ensures ((!state.settled?) ==> step(state, event).state.settled? ==> (!step(state, event).state.outcome.rejected?) ==> (step(state, event).state.failedGate == -1))
{
}

function outcomeOf(state: MachineState): ReportedOutcome
{
  match state {
    case settled(i_state_outcome, i_state_failedGate) =>
      if i_state_outcome.ok? then
        ReportedOutcome.ok
      else
        if i_state_outcome.rejected? then
          ReportedOutcome.rejected
        else
          if i_state_outcome.failedHandler? then
            ReportedOutcome.failedHandler
          else
            if i_state_outcome.failedResult? then
              ReportedOutcome.failedResult
            else
              if i_state_outcome.cancelledBefore? then
                ReportedOutcome.cancelledBefore
              else
                ReportedOutcome.cancelledDuring
    case _ =>
      ReportedOutcome.pending
  }
}

lemma outcomeOf_ensures(state: MachineState)
  ensures (state.settled? <==> (!outcomeOf(state).pending?))
  ensures (state.settled? ==> state.outcome.ok? ==> outcomeOf(state).ok?)
  ensures (state.settled? ==> state.outcome.rejected? ==> outcomeOf(state).rejected?)
  ensures (state.settled? ==> state.outcome.failedHandler? ==> outcomeOf(state).failedHandler?)
  ensures (state.settled? ==> state.outcome.failedResult? ==> outcomeOf(state).failedResult?)
  ensures (state.settled? ==> state.outcome.cancelledBefore? ==> outcomeOf(state).cancelledBefore?)
  ensures (state.settled? ==> state.outcome.cancelledDuring? ==> outcomeOf(state).cancelledDuring?)
{
}

// ---------------------------------------------------------------------------
// Trace obligations for the interpreter.
//
// `step` is proved above for one transition. These lemmas lift it to event
// traces of any length, which is what the interpreter actually runs.
//
// Additions only: `lsc regen` three-way merges this block, so it survives a
// regeneration after the annotated TypeScript changes.
// ---------------------------------------------------------------------------

// The admission gate index stays in range. Only `admitting` carries a gate, and
// it advances only while below LAST_GATE_INDEX.
ghost predicate WellFormed(s: MachineState)
{
  s.admitting? ==> (0 <= s.gate <= 3)
}

// A total `step`. `step` itself carries the range precondition above; this
// wrapper makes the fold total so the lemmas can quantify over every state.
function stepTotal(state: MachineState, event: MachineEvent): MachineStep
{
  if state.admitting? && !(0 <= state.gate <= 3) then
    MachineStep(state, MachineAction.idle)
  else
    step(state, event)
}

lemma StepTotalWellFormed(state: MachineState, event: MachineEvent)
  requires WellFormed(state)
  ensures WellFormed(stepTotal(state, event).state)
{
}

// The trace interpreter: apply every event in order.
function fold(state: MachineState, events: seq<MachineEvent>): MachineState
  decreases |events|
{
  if |events| == 0 then state
  else fold(stepTotal(state, events[0]).state, events[1..])
}

lemma FoldWellFormed(state: MachineState, events: seq<MachineEvent>)
  requires WellFormed(state)
  ensures WellFormed(fold(state, events))
  decreases |events|
{
  if |events| != 0 {
    StepTotalWellFormed(state, events[0]);
    FoldWellFormed(stepTotal(state, events[0]).state, events[1..]);
  }
}

// Unfolding: the fold is one step plus the rest of the trace.
lemma FoldUnfold(state: MachineState, events: seq<MachineEvent>)
  requires |events| != 0
  ensures fold(state, events) == fold(stepTotal(state, events[0]).state, events[1..])
{
}

// Splitting: folding a concatenation is folding each part in turn.
lemma FoldAppend(state: MachineState, front: seq<MachineEvent>, back: seq<MachineEvent>)
  ensures fold(state, front + back) == fold(fold(state, front), back)
  decreases |front|
{
  if |front| == 0 {
    assert front + back == back;
  } else {
    assert (front + back)[0] == front[0];
    assert (front + back)[1..] == front[1..] + back;
    FoldAppend(stepTotal(state, front[0]).state, front[1..], back);
  }
}

lemma FoldPrefix(state: MachineState, events: seq<MachineEvent>, i: nat)
  requires i <= |events|
  ensures fold(state, events) == fold(fold(state, events[0..i]), events[i..])
{
  assert events == events[0..i] + events[i..];
  FoldAppend(state, events[0..i], events[i..]);
}

// Non-vacuity witness: four passing gates take the machine from gate 0 to
// the execution gate.
lemma AllPassReachesGate(state: MachineState, events: seq<MachineEvent>)
  requires state.admitting? && state.gate == 0
  requires |events| == 4
  requires forall i :: 0 <= i < |events| ==> events[i].gatePassed?
  ensures fold(state, events).awaitingGate?
{
  var s1 := stepTotal(state, events[0]).state;
  var s2 := stepTotal(s1, events[1]).state;
  var s3 := stepTotal(s2, events[2]).state;
  var s4 := stepTotal(s3, events[3]).state;
  assert s1.admitting? && s1.gate == 1;
  assert s2.admitting? && s2.gate == 2;
  assert s3.admitting? && s3.gate == 3;
  assert s4.awaitingGate?;
  assert events == [events[0]] + events[1..];
  FoldUnfold(state, events);
  assert events[1..] == [events[1]] + events[2..];
  FoldUnfold(s1, events[1..]);
  assert events[2..] == [events[2]] + events[3..];
  FoldUnfold(s2, events[2..]);
  assert events[3..] == [events[3]] + events[4..];
  FoldUnfold(s3, events[3..]);
  assert events[4..] == [];
  assert fold(s4, events[4..]) == s4;
  assert fold(state, events) == s4;
}

// INV-SETTLE-ONCE, absorption half: a settled state ignores every later event.
lemma SettledAbsorbs(state: MachineState, events: seq<MachineEvent>)
  requires state.settled?
  ensures fold(state, events) == state
  decreases |events|
{
  if |events| != 0 {
    assert stepTotal(state, events[0]).state == state;
    assert stepTotal(state, events[0]).action.idle?;
    SettledAbsorbs(state, events[1..]);
  }
}

// INV-SETTLE-ONCE: once any event settles the invocation, the fold ends
// settled and every later event is inert.
lemma SettleIsTerminal(state: MachineState, events: seq<MachineEvent>, i: nat)
  requires WellFormed(state)
  requires i < |events|
  requires stepTotal(fold(state, events[0..i]), events[i]).action.settle?
  ensures fold(state, events).settled?
  decreases |events| - i
{
  FoldPrefix(state, events, i);
  var before := fold(state, events[0..i]);
  assert stepTotal(before, events[i]).state.settled?;
  SettledAbsorbs(stepTotal(before, events[i]).state, events[i+1..]);
}

// INV-SETTLE-ONCE: no event settles an already-settled state.
lemma StepSettlesOnlyOnce(state: MachineState, event: MachineEvent)
  requires WellFormed(state)
  ensures stepTotal(state, event).action.settle? ==> !state.settled? && stepTotal(state, event).state.settled?
{
}

// INV-RUN-ONCE: `runHandler` is emitted only on `awaitingGate` -> `executing`.
lemma RunHandlerOnlyFromAwaitingGate(state: MachineState, event: MachineEvent)
  ensures stepTotal(state, event).action.runHandler? ==>
            (state.awaitingGate? && event.gateRan? && stepTotal(state, event).state.executing?)
{
}

// INV-RUN-ONCE: the only event that leaves `awaitingGate` `awaitingGate` is
// `gatePending`, so a deferred gate cannot re-enter the run transition.
lemma StepLeavesAwaitingGate(state: MachineState, event: MachineEvent)
  requires state.awaitingGate?
  ensures event.gateRan? ==> stepTotal(state, event).state.executing?
  ensures !event.gateRan? && !event.aborted? ==> stepTotal(state, event).state.awaitingGate?
{
}

// INV-CANCEL-OUTCOME: an abort before execution settles `cancelledBefore`,
// an abort during execution settles `cancelledDuring`.
lemma AbortOutcomeMatchesPhase(state: MachineState)
  requires WellFormed(state) && !state.settled?
  ensures stepTotal(state, MachineEvent.aborted).state.outcome.cancelledBefore? == !state.executing?
  ensures stepTotal(state, MachineEvent.aborted).state.outcome.cancelledDuring? == state.executing?
{
}

// INV-GATE-ORDER: a refused invocation names the gate that refused it, and
// that gate is the one currently under evaluation.
lemma GateFailureNamesCurrentGate(state: MachineState)
  requires WellFormed(state) && state.admitting?
  ensures stepTotal(state, MachineEvent.gateFailed).state.outcome.rejected?
  ensures stepTotal(state, MachineEvent.gateFailed).state.failedGate == state.gate
{
}

// INV-GATE-ORDER: passing a non-final gate advances by exactly one index, and
// passing the final gate leaves admission for the execution gate.
lemma GatePassAdvancesInOrder(state: MachineState)
  requires WellFormed(state) && state.admitting?
  ensures state.gate < 3 ==> (stepTotal(state, MachineEvent.gatePassed).state.admitting? &&
                              stepTotal(state, MachineEvent.gatePassed).state.gate == state.gate + 1)
  ensures state.gate == 3 ==> stepTotal(state, MachineEvent.gatePassed).state.awaitingGate?
  ensures state.gate < 3 ==> stepTotal(state, MachineEvent.gatePassed).action.evaluateGate?
  ensures state.gate == 3 ==> stepTotal(state, MachineEvent.gatePassed).action.openGate?
{
}

// INV-GATE-ORDER: `openGate` is unreachable without four passes from gate 0.
lemma OpenGateRequiresAllGates(state: MachineState)
  requires WellFormed(state) && state.admitting?
  ensures stepTotal(state, MachineEvent.gatePassed).action.openGate? == (state.gate == 3)
{
}
